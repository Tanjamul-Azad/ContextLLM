  "target": {
    "task": "Our private university in Dhaka has one 400-space car park for staff and students. Most cars arrive between 8:00 and 10:00, the car park is about half empty after 14:00, and it is almost empty after 19:00. Design the weekday parking fee schedule for 7:00 to 22:00.",
    "rules": [
      {
        "id": "R1",
        "text": "Use 3 or 4 time periods that together cover 7 to 22 without gaps, with whole-hour start and end times.",
        "checks": [
          {
            "id": "R1a",
            "spec": [
              "json_len_between",
              "periods",
              3,
              4
            ]
          },
          {
            "id": "R1b",
            "spec": [
              "json_ranges_cover",
              "periods",
              "start_hour",
              "end_hour",
              7,
              22
            ]
          },
          {
            "id": "R1c",
            "spec": [
              "json_all_int",
              "periods[].start_hour"
            ]
          },
          {
            "id": "R1d",
            "spec": [
              "json_all_int",
              "periods[].end_hour"
            ]
          }
        ]
      },
      {
        "id": "R2",
        "text": "Each period has one fee per entry in whole BDT, from 0 to 100.",
        "checks": [
          {
            "id": "R2a",
            "spec": [
              "json_all_int",
              "periods[].fee_bdt"
            ]
          },
          {
            "id": "R2b",
            "spec": [
              "json_all_ge",
              "periods[].fee_bdt",
              0
            ]
          },
          {
            "id": "R2c",
            "spec": [
              "json_all_le",
              "periods[].fee_bdt",
              100
            ]
          }
        ]
      },
      {
        "id": "R3",
        "text": "Include a monthly staff pass priced at no more than 1500 BDT.",
        "checks": [
          {
            "id": "R3a",
            "spec": [
              "json_all_int",
              "staff_monthly_pass_bdt"
            ]
          },
          {
            "id": "R3b",
            "spec": [
              "json_all_le",
              "staff_monthly_pass_bdt",
              1500
            ]
          }
        ]
      }
